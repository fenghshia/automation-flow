# Copy this file to .env and replace placeholder values with local credentials.
DB_HOST=<ip>
DB_PORT=5432
DB_NAME=auto-flow
DB_USER=<user>
DB_PASSWORD=<passwd>
# 打分规则文件
JD_SCORE_RULES_FILE=private/score_rules.md
# 简历文件
JD_RESUME_FILE=private/jl.md
# Gemini 配置
GEMINI_API_KEY=<gemini_api_key>
GEMINI_BASE_URL=<gemini_base_url>
# 火狐插件打包密钥
WEB_EXT_SIGN_API_KEY=<web_ext_sign_api_key>
WEB_EXT_SIGN_API_SECRET=<web_ext_sign_api_secret>
# iwara下载目录
IWARA_DOWNLOAD_DIR=<iwara_download_dir>
# 视频压缩目录与 FFmpeg 工具目录
VIDEO_COMPRESSION_SOURCE_DIR=<video_source_dir>
VIDEO_COMPRESSION_OUTPUT_DIR=<video_output_dir>
VIDEO_COMPRESSION_FFMPEG_BIN_DIR=<ffmpeg_bin_dir>
