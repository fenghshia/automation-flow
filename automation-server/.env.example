# Copy this file to .env and replace placeholder values with local credentials.
DB_HOST=<ip>
DB_PORT=5432
DB_NAME=auto-flow
DB_USER=<user>
DB_PASSWORD=<passwd>
# 打分规则文件
JD_SCORE_RULES_FILE=private/score_rules.md
# 简历文件
JD_RESUME_FILE=private/jl.md
# Gemini 配置
GEMINI_API_KEY=<gemini_api_key>
GEMINI_BASE_URL=<gemini_base_url>
# 火狐插件打包密钥
WEB_EXT_SIGN_API_KEY=<web_ext_sign_api_key>
WEB_EXT_SIGN_API_SECRET=<web_ext_sign_api_secret>
# iwara下载目录
IWARA_DOWNLOAD_DIR=<iwara_download_dir>
# 视频压缩目录与 FFmpeg 工具目录
VIDEO_COMPRESSION_SOURCE_DIR=<video_source_dir>
VIDEO_COMPRESSION_OUTPUT_DIR=<video_output_dir>
VIDEO_COMPRESSION_FFMPEG_BIN_DIR=<ffmpeg_bin_dir>
# Shared NVENC budget; at most one compression uses each physical GPU.
VIDEO_COMPRESSION_GPU_PEAK_MIB=1024
# Maximum wait for GPU admission, separate from the FFmpeg execution timeout.
VIDEO_COMPRESSION_GPU_WAIT_SECONDS=1800
# 图片整理、压缩目录与 7-Zip 工具目录
IMAGE_COMPRESSION_SOURCE_DIR=<image_source_dir>
IMAGE_COMPRESSION_OUTPUT_DIR=<image_output_dir>
IMAGE_COMPRESSION_7ZIP_BIN_DIR=<7zip_bin_dir>

# Local video preference filtering (disabled until schema, summaries and model are ready)
VIDEO_FILTER_ENABLED=false
VIDEO_FILTER_GROUPS_CONFIG=private/video_filter_groups.json
# Copy video_filter/groups.example.json and fill ONLY your group's five roots.
# Stable names identify independent datasets; liked_source is never sampled.
# Relative config paths resolve from automation-server/ regardless of the launch directory.
# Independent workspace for locks, temporary extraction transport and feedback retry events;
# feature summaries and personal classifier parameters live in DB.
VIDEO_FILTER_STATE_DIR=video_filter/state
VIDEO_FILTER_MODEL_MANIFEST=video_filter/weights/manifest.json
# Optional override; otherwise reuse VIDEO_COMPRESSION_FFMPEG_BIN_DIR
VIDEO_FILTER_FFMPEG_BIN_DIR=
VIDEO_FILTER_DEVICE=cuda:0
# Classifier, training parameters and transfer/compression flags live in group JSON.
VIDEO_FILTER_EXTRACT_CONCURRENCY=6
VIDEO_FILTER_WORKER_CPU_THREADS=1
VIDEO_FILTER_BATCH_SIZE=1
# Per-modality forward limits (1..64), overriding the legacy batch size.
VIDEO_FILTER_DINO_BATCH_SIZE=16
VIDEO_FILTER_VIDEOMAE_BATCH_SIZE=4
VIDEO_FILTER_BEATS_BATCH_SIZE=8
# Lazy persistent workers, bounded CPU model cache per process, idle/task retirement.
VIDEO_FILTER_PERSISTENT_WORKERS=true
VIDEO_FILTER_WORKER_MODEL_CACHE_MIB=768
VIDEO_FILTER_WORKER_IDLE_SECONDS=120
VIDEO_FILTER_WORKER_MAX_TASKS=100
# Incremental GPU budgets (MiB); safety is reserved once per physical GPU.
VIDEO_FILTER_GPU_EXTRACT_PEAK_MIB=1024
VIDEO_FILTER_GPU_PREDICT_PEAK_MIB=256
VIDEO_FILTER_GPU_SAFETY_MIB=1024
# Per-worker RAM cache; raw audio is never persisted.
VIDEO_FILTER_AUDIO_CACHE_MIB=32
VIDEO_FILTER_SCAN_INTERVAL_SECONDS=60
VIDEO_FILTER_STABLE_SECONDS=60
VIDEO_FILTER_MISSING_SECONDS=300
VIDEO_FILTER_TASK_TIMEOUT_SECONDS=1800
# Grouped mode always tracks lineage and confirmed deletion feedback.
